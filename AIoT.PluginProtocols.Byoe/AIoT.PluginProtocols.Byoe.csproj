<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AIoT.PluginProtocols.Byoe</RootNamespace>
    <AssemblyName>AIoT.PluginProtocols.Byoe</AssemblyName>
    <PluginOutputRoot>..\AIoT\bin\$(Configuration)\net10.0\plugins</PluginOutputRoot>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIoT\AIoT.csproj" />
    <ProjectReference Include="..\Byoe\Byoe.csproj" />
    <PackageReference Include="System.IO.Ports" Version="11.0.0-preview.3.26207.106" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0-preview.3.26207.106" />
  </ItemGroup>

  <Target Name="CopyPluginToAiotPluginsFolder" AfterTargets="Build">
    <MakeDir Directories="$(PluginOutputRoot)" />

    <ItemGroup>
      <PluginArtifacts Include="$(TargetDir)$(AssemblyName).dll" />
      <PluginArtifacts Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <PluginDependencyArtifacts Include="$(TargetDir)Byoe*.dll" />
      <PluginDependencyArtifacts Include="$(TargetDir)System.IO.Ports.dll" Condition="Exists('$(TargetDir)System.IO.Ports.dll')" />
      <PluginDependencyArtifacts Include="$(TargetDir)System.Drawing.Common.dll" Condition="Exists('$(TargetDir)System.Drawing.Common.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginArtifacts)"
          DestinationFolder="$(PluginOutputRoot)"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(PluginDependencyArtifacts)"
          DestinationFolder="$(PluginOutputRoot)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
